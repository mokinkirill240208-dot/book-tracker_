import json
import os

DATA_FILE = "books.json"

def load_books():
    if not os.path.exists(DATA_FILE):
        return []
    with open(DATA_FILE, "r", encoding="utf-8") as f:
        try:
            return json.load(f)
        except json.JSONDecodeError:
            return []

def save_books(books):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(books, f, ensure_ascii=False, indent=2)

def show_books(books):
    if not books:
        print("Список книг пуст.")
        return False
    for i, book in enumerate(books, 1):
        print(f"{i}. {book['author']} — «{book['title']}» | Оценка: {book['rating']} | Дата: {book['date']}")
    return True

def delete_book(books):
    if not books:
        print("Нет книг для удаления.\n")
        return
    show_books(books)
    try:
        idx = int(input("Введите номер книги для удаления: ")) - 1
        if 0 <= idx < len(books):
            removed = books.pop(idx)
            save_books(books)
            print(f"Удалена книга: {removed['author']} — «{removed['title']}»\n")
        else:
            print("Неверный номер.\n")
    except ValueError:
        print("Введите число.\n")

def main():
    books = load_books()
    while True:
        print("\n=== Трекер прочитанных книг ===")
        print("1. Добавить книгу (в разработке)")
        print("2. Показать все книги (в разработке)")
        print("3. Показать среднюю оценку (в разработке)")
        print("4. Статистика по авторам (в разработке)")
        print("5. Удалить книгу")
        print("6. Выход")
        choice = input("Выберите действие: ").strip()
        if choice == "5":
            delete_book(books)
        elif choice == "6":
            print("До свидания!")
            break
        else:
            print("Этот функционал будет добавлен позже.\n")

if __name__ == "__main__":
    main()
