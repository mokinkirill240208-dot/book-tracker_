import json
import os
from datetime import datetime

DATA_FILE = "books.json"

def load_books():
    if not os.path.exists(DATA_FILE):
        return []
    with open(DATA_FILE, "r", encoding="utf-8") as f:
        try:
            return json.load(f)
        except json.JSONDecodeError:
            return []

def save_books(books):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(books, f, ensure_ascii=False, indent=2)

def add_book(books):
    author = input("Автор: ").strip()
    title = input("Название: ").strip()
    # Проверка дубликатов (будет закрывать Issue #1)
    for book in books:
        if book["author"].lower() == author.lower() and book["title"].lower() == title.lower():
            print("Такая книга уже есть в списке!\n")
            return
    while True:
        try:
            rating = int(input("Оценка (1–5): "))
            if 1 <= rating <= 5:
                break
            else:
                print("Оценка должна быть от 1 до 5")
        except ValueError:
            print("Введите целое число")
    date = input("Дата прочтения (ГГГГ-ММ-ДД): ").strip()
    try:
        datetime.strptime(date, "%Y-%m-%d")
    except ValueError:
        print("Неверный формат даты, будет использована сегодняшняя")
        date = datetime.now().strftime("%Y-%m-%d")
    books.append({
        "author": author,
        "title": title,
        "rating": rating,
        "date": date
    })
    save_books(books)
    print("Книга добавлена!\n")

def main():
    books = load_books()
    while True:
        print("\n=== Трекер прочитанных книг ===")
        print("1. Добавить книгу")
        print("2. Показать все книги (в разработке)")
        print("3. Показать среднюю оценку (в разработке)")
        print("4. Статистика по авторам (в разработке)")
        print("5. Удалить книгу (в разработке)")
        print("6. Выход")
        choice = input("Выберите действие: ").strip()
        if choice == "1":
            add_book(books)
        elif choice == "6":
            print("До свидания!")
            break
        else:
            print("Этот функционал будет добавлен позже.\n")

if __name__ == "__main__":
    main()
